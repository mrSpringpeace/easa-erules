<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<pkg:package xmlns:pkg="http://schemas.microsoft.com/office/2006/xmlPackage">
  <pkg:part pkg:name="/[Content_Types].xml" pkg:contentType="application/xml" pkg:padding="512">
    <pkg:xmlData>
      <Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
        <Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>
        <Default Extension="xml" ContentType="application/xml"/>
        <Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/>
      </Types>
    </pkg:xmlData>
  </pkg:part>
  <pkg:part pkg:name="/_rels/.rels" pkg:contentType="application/vnd.openxmlformats-package.relationships+xml" pkg:padding="256">
    <pkg:xmlData>
      <Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">
        <Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/>
      </Relationships>
    </pkg:xmlData>
  </pkg:part>
  <pkg:part pkg:name="/word/document.xml" pkg:contentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml" pkg:padding="512">
    <pkg:xmlData>
      <w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"
                  xmlns:erules="http://www.easa.europa.eu/erules">
        <w:body>
          <erules:metadata>
            <erules:id>ERULES-CS-VLA-001</erules:id>
            <erules:title>Easy Access Rules for Very Light Aeroplanes</erules:title>
            <erules:regulatorySource>CS-VLA</erules:regulatorySource>
            <erules:regulatorySubject>Airworthiness</erules:regulatorySubject>
            <erules:typeOfContent>Certification Specification</erules:typeOfContent>
            <erules:technicalSubjectMatter>Structures</erules:technicalSubjectMatter>
            <erules:aircraftCategory>Aeroplanes</erules:aircraftCategory>
            <erules:aircraftUse>Very Light</erules:aircraftUse>
            <erules:applicabilityDate>2020-01-01</erules:applicabilityDate>
          </erules:metadata>
          <erules:topic>
            <erules:id>CS-VLA.303</erules:id>
            <erules:title>CS-VLA.303 Factor of safety</erules:title>
            <erules:metadata>
              <erules:typeOfContent>Certification Specification</erules:typeOfContent>
              <erules:technicalSubjectMatter>Structures</erules:technicalSubjectMatter>
            </erules:metadata>
            <w:p>
              <w:r>
                <w:t>A factor of safety of 1.5 must be applied to all limit loads unless otherwise specified.</w:t>
              </w:r>
            </w:p>
            <w:p>
              <w:pPr>
                <w:pStyle w:val="Heading1"/>
              </w:pPr>
              <w:r>
                <w:t>Subpart A - General</w:t>
              </w:r>
            </w:p>
            <w:p>
              <w:r>
                <w:t>This regulation applies to all very light aeroplanes.</w:t>
              </w:r>
            </w:p>
          </erules:topic>
          <erules:topic>
            <erules:id>CS-VLA.305</erules:id>
            <erules:title>CS-VLA.305 Strength and deformation</erules:title>
            <erules:metadata>
              <erules:typeOfContent>Certification Specification</erules:typeOfContent>
              <erules:technicalSubjectMatter>Structures</erules:technicalSubjectMatter>
            </erules:metadata>
            <w:p>
              <w:r>
                <w:t>The structure must be able to withstand limit loads without detrimental deformation.</w:t>
              </w:r>
            </w:p>
          </erules:topic>
        </w:body>
      </w:document>
    </pkg:xmlData>
  </pkg:part>
</pkg:package>